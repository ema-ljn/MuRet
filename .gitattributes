# Fines de línea: git detecta qué es texto y lo guarda con LF, como en sven-n/MuMain. Importa
# porque CI compila también en Windows (core.autocrlf). Los vectores de bytes de los tests tienen
# su propio .gitattributes en Client/tests/vectors/.
* text=auto

*.cpp text
*.h text
*.c text
*.cmake text
CMakeLists.txt text
CMakePresets.json text
*.json text
*.md text
*.yml text
.clang-format text
.clang-tidy text
.editorconfig text
.gitattributes text

# Lo que corre en Linux (sh, python) va siempre con LF.
*.sh text eol=lf
*.py text eol=lf
